www.aegis-gate.ru {
	redir https://aegis-gate.ru{uri} permanent
}

aegis-gate.ru {
	log {
		output file /var/log/caddy-access/aegis.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
	@cabinet path /auth/* /api/me /api/login /api/logout /api/link /api/health
	handle @cabinet {
		reverse_proxy aegis-gate-cabinet:8766
	}
	handle {
		reverse_proxy aegis-gate-landing:80
	}
}
